{
    "Comment": "A state machine that syncs Wikipedia pages to GitHub.",
    "StartAt": "Sync revisions",
    "States": {
        "Sync revisions": {
            "Type": "Task",
            "Resource": "${RevisionSyncFunctionArn}",
            "Next": "Check status"
        },
        "Check status": {
            "Type": "Choice",
            "Choices": [
                {
                    "Variable": "$.success",
                    "BooleanEquals": false,
                    "Next": "Handle sync failure"
                },
                {
                    "Variable": "$.max_iterations_reached",
                    "BooleanEquals": true,
                    "Next": "Partially synced!"
                },
                {
                    "Variable": "$.needs_sync",
                    "BooleanEquals": true,
                    "Next": "Sync revisions"
                }
            ],
            "Default": "Up to date!"
        },
        "Partially synced!": {
            "Type": "Succeed"
        },
        "Up to date!": {
            "Type": "Succeed"
        },
        "Handle sync failure": {
            "Type": "Fail",
            "Error": "SyncFailure",
            "CausePath": "$.message"
        }
    }
}
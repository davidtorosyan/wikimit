{
    "Comment": "A state machine that syncs Wikipedia pages to GitHub.",
    "StartAt": "Sync revisions",
    "States": {
        "Sync revisions": {
            "Type": "Task",
            "Resource": "${RevisionSyncFunctionArn}",
            "Retry": [
                {
                    "ErrorEquals": [
                        "States.TaskFailed"
                    ],
                    "IntervalSeconds": 15,
                    "MaxAttempts": 5,
                    "BackoffRate": 1.5
                }
            ],
            "Next": "Check status"
        },
        "Check status": {
            "Type": "Choice",
            "Choices": [
                {
                    "And": [
                        {
                            "Variable": "$.success",
                            "BooleanEquals": true
                        },
                        {
                            "Variable": "$.needs_sync",
                            "BooleanEquals": true
                        }
                    ],
                    "Next": "Sync revisions"
                },
                {
                    "Variable": "$.success",
                    "BooleanEquals": false,
                    "Next": "Handle sync failure"
                }
            ],
            "Default": "Up to date!"
        },
        "Up to date!": {
            "Type": "Succeed"
        },
        "Handle sync failure": {
            "Type": "Fail",
            "Error": "SyncFailure",
            "CausePath": "$.message"
        }
    }
}